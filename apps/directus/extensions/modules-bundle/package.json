{
  "name": "@claread/directus-modules",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "directus-extension build",
    "watch": "directus-extension build --watch"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "11.0.10",
    "typescript": "^5.8.3",
    "vue": "3.4.27",
    "vue-router": "4.4.0",
    "zod": "3.23.8"
  },
  "directus:extension": {
    "type": "bundle",
    "host": "^11.0.0",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "display",
        "name": "claread-status-badge",
        "source": "src/claread-status-badge/index.js"
      },
      {
        "type": "display",
        "name": "claread-usage-summary",
        "source": "src/claread-usage-summary/index.js"
      },
      {
        "type": "display",
        "name": "claread-json-summary",
        "source": "src/claread-json-summary/index.js"
      },
      {
        "type": "display",
        "name": "claread-record-context-display",
        "source": "src/claread-record-context-display/index.js"
      },
      {
        "type": "display",
        "name": "claread-enum-label-display",
        "source": "src/claread-enum-label-display/index.js"
      },
      {
        "type": "display",
        "name": "claread-event-type-display",
        "source": "src/claread-event-type-display/index.js"
      },
      {
        "type": "display",
        "name": "claread-inspector-launcher",
        "source": "src/claread-inspector-launcher/index.js"
      },
      {
        "type": "interface",
        "name": "claread-json-summary-interface",
        "source": "src/claread-json-summary-interface/index.js"
      },
      {
        "type": "interface",
        "name": "claread-record-context-interface",
        "source": "src/claread-record-context-interface/index.js"
      },
      {
        "type": "interface",
        "name": "claread-text-preview-interface",
        "source": "src/claread-text-preview-interface/index.js"
      },
      {
        "type": "interface",
        "name": "claread-enum-label-interface",
        "source": "src/claread-enum-label-interface/index.js"
      },
      {
        "type": "interface",
        "name": "claread-inspector-launcher-interface",
        "source": "src/claread-inspector-launcher-interface/index.js"
      },
      {
        "type": "interface",
        "name": "claread-relational-events-display",
        "source": "src/claread-relational-events-display/index.js"
      },
      {
        "type": "module",
        "name": "claread-render-scene-inspector",
        "source": "src/claread-render-scene-inspector/index.js"
      },
      {
        "type": "module",
        "name": "claread-eval-center",
        "source": "src/claread-eval-center/index.js"
      },
      {
        "type": "layout",
        "name": "claread-observability-groups",
        "source": "src/claread-observability-groups-layout/index.js"
      }
    ]
  },
  "pnpm": {
    "executionEnv": {
      "nodeVersion": "22.14.0"
    }
  }
}
