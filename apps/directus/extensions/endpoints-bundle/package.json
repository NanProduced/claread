{
  "name": "@claread/directus-endpoints",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "directus-extension build",
    "test": "node --test src/reader-orch/index.test.mjs",
    "watch": "directus-extension build --watch"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "11.0.10",
    "typescript": "^5.8.3",
    "vue": "3.4.27",
    "vue-router": "4.4.0",
    "zod": "3.23.8"
  },
  "directus:extension": {
    "type": "bundle",
    "host": "^11.0.0",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "reader-orch",
        "source": "src/reader-orch/index.js"
      }
    ]
  },
  "pnpm": {
    "executionEnv": {
      "nodeVersion": "22.14.0"
    }
  }
}
