# ── Directus 核心 ──────────────────────────────────────────────

# Directus 服务端加密密钥，用于签名 JWT 和加密敏感数据
# 首次部署时生成一个随机字符串，之后不要更改，否则已有 session 失效
SECRET=change-me-directus-secret

# Directus 对外访问 URL，用于生成回调链接和 CORS
PUBLIC_URL=http://127.0.0.1:8055

# 登录后默认跳转路径
ROOT_REDIRECT=/admin/content

# Directus 初始管理员账号
ADMIN_EMAIL=admin@claread.dev
ADMIN_PASSWORD=change-me

# Directus 静态 Admin Token，用于脚本和 eval-center sync-metadata
# 对应 Directus 的 STATIC_TOKENS 配置
ADMIN_TOKEN=change-me-admin-token

# ── Directus 扩展 ─────────────────────────────────────────────

# 扩展目录（容器内路径，一般不需要改）
EXTENSIONS_PATH=/directus/extensions

# 扩展自动重载，开发时保持 true
EXTENSIONS_AUTO_RELOAD=true

# Docker 挂载卷文件监听轮询，Windows/macOS Docker 必须开启
CHOKIDAR_USEPOLLING=true

# Directus schema 跟踪时排除的表（逗号分隔），留空不排除
DB_EXCLUDE_TABLES=

# ── Claread Eval Center ──────────────────────────────────────

# Claread API 服务地址（容器内访问宿主机的 API）
# 对应 services/api 的监听地址，默认 http://127.0.0.1:8000
# Docker 容器内用 host.docker.internal 访问宿主机
CLAREAD_API_BASE_URL=http://host.docker.internal:8000

# 调用 Claread API eval 端点的 admin key
# 必须与 services/api/.env 中的 EVAL_ADMIN_API_KEY 一致
# 如果未设置，fallback 读取 DAILY_READER_ADMIN_API_KEY（不推荐）
CLAREAD_API_ADMIN_KEY=your-eval-admin-key-here

# Directus proxy 转发 node-probe 请求的超时时间（毫秒）
# 应大于 services/api 中 LLM node 的最大执行时间
CLAREAD_EVAL_PROXY_TIMEOUT_MS=60000

# evals/runs 目录在容器内的只读挂载路径
# 对应 docker-compose.directus.yml 中的 volume 挂载 ../../evals:/directus/evals:ro
# 一般不需要改
CLAREAD_EVAL_RUNS_ROOT=/directus/evals/runs
