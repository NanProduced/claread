{
  "version": "v2",
  "shared_defaults": {
    "call_granularity": {
      "rubric_only": 1,
      "rubric_plus_pairwise": 2,
      "anti_template_probe": 1
    },
    "packet_limits": {
      "grammar_max_items_per_side": 6,
      "vocabulary_max_items_per_side": 8,
      "translation_max_sentences_per_side": 8
    }
  },
  "presets": [
    {
      "preset_id": "grammar-default-v1",
      "title": "Grammar 默认评测",
      "node_name": "grammar",
      "strategy": "grammar_item_review",
      "method": "rubric_plus_pairwise",
      "ui_label": "逐条三档打分 + 整体对比评估（默认）",
      "packet_policy": {
        "priority_profile": "structure_first",
        "max_items_per_side": 6,
        "include_raw_appendix": false
      },
      "rubric_bundle": {
        "grammar_note": ["GN1", "GN2", "GN3", "GN4"],
        "sentence_analysis": ["GS1", "GS2", "GS3", "GS4"]
      },
      "pairwise": {
        "enabled": true,
        "question": "基于原文与精选标注信息，比较两版整体讲解质量与策略适配度，并给出整体评估意见。"
      }
    },
    {
      "preset_id": "grammar-anti-template-v1",
      "title": "Grammar 反模板化检查",
      "node_name": "grammar",
      "strategy": "grammar_item_review",
      "method": "anti_template_probe",
      "ui_label": "反模板化检查",
      "packet_policy": {
        "sampling_mode": "broad_probe_sample",
        "max_items_per_side": 8,
        "include_raw_appendix": false
      },
      "output_mode": "probe_appendix",
      "probe_appendix": {
        "questions": [
          {
            "id": "AT1",
            "prompt": "两版输出是否明显反复使用同一种结构说明套路？如果是，请指出最典型的重复模式；如果否，简要说明为何认为没有。"
          },
          {
            "id": "AT2",
            "prompt": "是否存在本应更值得讲的结构点被系统性忽略，而另一类结构被重复强调？如果是，请指出最典型的偏斜。"
          }
        ]
      }
    },
    {
      "preset_id": "vocabulary-default-v1",
      "title": "Vocabulary 默认评测",
      "node_name": "vocabulary",
      "strategy": "vocabulary_item_review",
      "method": "rubric_plus_pairwise",
      "ui_label": "逐条三档打分 + 整体对比评估（默认）",
      "packet_policy": {
        "max_items_per_side": 8,
        "include_raw_appendix": false,
        "priority_profile_by_variant": {
          "cet": "collocation_first",
          "default": "default"
        }
      },
      "rubric_bundle": {
        "vocab_highlight": ["VH1", "VH2"],
        "phrase_gloss": ["PG1", "PG2"],
        "context_gloss": ["CG1", "CG2"]
      },
      "pairwise": {
        "enabled": true,
        "question": "基于原文与精选词汇标注信息，比较两版词汇帮助整体是否更贴合当前场景，并给出整体评估意见。"
      }
    },
    {
      "preset_id": "translation-default-v1",
      "title": "Translation 默认评测",
      "node_name": "translation",
      "strategy": "translation_output_review",
      "method": "rubric_plus_pairwise",
      "ui_label": "整体三档打分 + 整体对比评估（默认）",
      "packet_policy": {
        "max_sentences_per_side": 8,
        "include_raw_appendix": false,
        "sentence_sampling": "head_and_tail"
      },
      "rubric_bundle": {
        "output_level": ["TT1", "TT2", "TT3", "TT4"]
      },
      "pairwise": {
        "enabled": true,
        "question": "基于原文与两版翻译，比较哪一版整体更利于当前用户理解原文，并说明不同翻译策略的匹配度。"
      }
    }
  ]
}
