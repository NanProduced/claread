APP_NAME="Claread透读"
APP_ENV="development"
LOG_LEVEL="INFO"

DATABASE_URL="postgresql://claread:claread_dev@127.0.0.1:5432/claread"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_MAX_INACTIVE_CONNECTION_LIFETIME=3600

REDIS_ENABLED=false
REDIS_URL="redis://127.0.0.1:6379/0"

WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
AUTH_SESSION_EXPIRY_DAYS=30

PHONE_AUTH_PROVIDER="mock"
PHONE_MOCK_VERIFICATION_CODE="888888"
# Set PHONE_AUTH_PROVIDER="aliyun_dypnsapi" to use Alibaba Cloud Dypnsapi.
# The provider also falls back to ALIBABA_CLOUD_ACCESS_KEY_ID /
# ALIBABA_CLOUD_ACCESS_KEY_SECRET when the ALIYUN_DYPNSAPI_* keys are empty.
ALIYUN_DYPNSAPI_ACCESS_KEY_ID=""
ALIYUN_DYPNSAPI_ACCESS_KEY_SECRET=""
ALIYUN_DYPNSAPI_ENDPOINT="dypnsapi.aliyuncs.com"
ALIYUN_DYPNSAPI_REGION_ID="cn-hangzhou"
ALIYUN_DYPNSAPI_SIGN_NAME=""
ALIYUN_DYPNSAPI_LOGIN_TEMPLATE_CODE="100001"
ALIYUN_DYPNSAPI_CODE_TTL_MINUTES=5
ALIYUN_DYPNSAPI_CODE_LENGTH=6
ALIYUN_DYPNSAPI_SEND_INTERVAL_SECONDS=60

# Reader source artifact uploads use Aliyun OSS presigned PUT URLs.
# Keep secrets out of committed files. In local development, either set
# ALIYUN_OSS_ACCESS_KEY_ID / ALIYUN_OSS_ACCESS_KEY_SECRET directly, or reuse
# the common Alibaba Cloud SDK variables:
# ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET.
# OSS-specific credentials win when both are present. If either OSS-specific
# credential is set, both must be set; the runtime never mixes one OSS-specific
# value with one generic Alibaba Cloud value.
ALIYUN_OSS_PRESIGN_ENABLED=false
ALIYUN_OSS_ACCESS_KEY_ID=""
ALIYUN_OSS_ACCESS_KEY_SECRET=""
ALIYUN_OSS_BUCKET="claread-dev"
ALIYUN_OSS_ENDPOINT="https://oss-cn-shenzhen.aliyuncs.com"
ALIYUN_OSS_PRESIGN_EXPIRES_SECONDS=900

# Reader OCR. Local qwen3.5-ocr uses DASHSCOPE_API_KEY below; keep disabled
# unless file/image OCR is intentionally enabled for the artifact worker.
READER_OCR_PROVIDER_ENABLED=false
READER_OCR_PROVIDER_NAME="qwen"
READER_OCR_QWEN_MODEL="qwen3.5-ocr"
READER_OCR_REQUEST_TIMEOUT_SECONDS=60

DEFAULT_MODEL_PROFILE=""
ANNOTATION_MODEL_PROFILE=""
DICT_AI_MODEL_PROFILE=""
# Semantic outline L2 is disabled by default. Set a registry profile and true together
# only when local development intentionally permits one bounded LLM call per eligible record.
READER_SEMANTIC_OUTLINE_MODEL_PROFILE=""
SEMANTIC_OUTLINE_GENERATION_ENABLED=false
# Ask Claread 默认主回答 profile。通常指向一个 ask-* profile，而不是直接指向 model。
ASK_CLAREAD_PROFILE=""
# Ask repair/replan 独立路由默认值。先看这里，再 fallback 到 ASK_CLAREAD_PROFILE。
READER_ASK_REPLAN_MODEL_PROFILE=""
DAILY_ANNOTATION_MODEL_PROFILE=""
DAILY_ANALYSIS_MODEL_PROFILE=""
DAILY_REVIEW_MODEL_PROFILE=""
# Grammar RAG 的 embedding / rerank 默认路由。建议优先走 registry profile；
# 只有这两个变量留空时，运行时才会回退到下面的 deprecated BAILIAN_* 字段。
RAG_EMBEDDING_MODEL_PROFILE=""
RAG_RERANK_MODEL_PROFILE=""
# `MODEL_PROFILES_JSON` 使用严格 JSON，结构固定为 `providers` / `models` / `profiles` 三层：
# - providers: 连接信息、API key env 名称、兼容性 profile
# - models: provider 下的远端模型名
# - profiles: 业务场景配置（例如 Ask 开 thinking、workflow 关 thinking）
MODEL_PROFILES_JSON="config/model-profiles.json"
MODEL_PRESETS_JSON="config/model-presets.json"
# Ask Claread 模型选择白名单。运营侧只需要维护这里暴露给用户的选项，不直接暴露全部 profile。
READER_ASK_MODEL_OPTIONS_JSON="config/reader-ask-model-options.json"
# 下面这些 provider key 可以只写在本地 .env，也可以由外部运行环境注入。
DASHSCOPE_API_KEY=""
DEEPSEEK_API_KEY=""
MINIMAX_API_KEY=""
MOONSHOT_API_KEY=""

LANGSMITH_ENABLED=false
LANGSMITH_TRACING=true
LANGSMITH_PROJECT="claread-dev"
LANGSMITH_API_KEY=""
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_WORKSPACE_ID=""

GUARDIAN_API_KEY=""
DAILY_READER_ADMIN_OPENID=""
DAILY_READER_ADMIN_API_KEY=""
SERVER_BASE_URL="http://127.0.0.1:8000"

GRAMMAR_RAG_ENABLED=false
ZILLIZ_URI=""
ZILLIZ_TOKEN=""
ZILLIZ_COLLECTION_GRAMMAR_NOTE="grammar_note_examples"
ZILLIZ_COLLECTION_SENTENCE_ANALYSIS="sentence_analysis_examples"
# Deprecated legacy fallback. 仅当 RAG_EMBEDDING_MODEL_PROFILE /
# RAG_RERANK_MODEL_PROFILE 未配置时才会使用。
BAILIAN_API_KEY=""
BAILIAN_EMBEDDING_MODEL="text-embedding-v4"
BAILIAN_EMBEDDING_DIMENSION=1024
BAILIAN_RERANK_MODEL="qwen3-rerank"
GRAMMAR_RAG_ANN_TOPK=8
GRAMMAR_RAG_RERANK_TOPN=5
GRAMMAR_RAG_CONFIDENCE_THRESHOLD=0.3

# -----------------------------------------------------------------------
# Article RAG (D6-I4T / I4U / I4V / I4W / I4X / I4Y)
#
# Drives `reader-article-rag-index-worker` and the
# GET/POST /reader/records/{id}/article-rag-index/{status,ensure} routes.
# The feature flag and all provider knobs default to "off / unconfigured",
# which means the worker starts cleanly but every job fails closed with
# `embedding_provider_unconfigured` / `vector_writer_unconfigured` — the
# article_ready main flow is never blocked.
#
# Full operational runbook: docs/initiatives/reader-agentic-orchestration/
#   modules/local-article-rag-runbook.md
# -----------------------------------------------------------------------
# Feature flag. false = article_ready auto-ensure is a no-op
# (ArticleRagAutoEnsureService returns disabled / rag_disabled).
# The manual GET status / POST ensure routes still use the lifecycle
# service semantics and are NOT gated by this flag — they return
# typed status (enqueued / idempotent_noop / generation_mismatch /
# not_ready / no_active_base / plan_hash_mismatch / bootstrap_inconsistent
# / record_not_found) based on the record's actual state, not on
# READER_ARTICLE_RAG_ENABLED.  If product intent is that manual ensure
# must also be gated, that is a separate route / service feature-gate,
# not a documentation fix here.
READER_ARTICLE_RAG_ENABLED=false
# Embedding provider. Empty / unresolvable → UnconfiguredArticleRagEmbeddingProvider.
# Values: "" | "dashscope". To enable the DashScope/Bailian embedding path,
# set RAG_EMBEDDING_MODEL_PROFILE="rag-embedding-v4" above (or provide the
# deprecated BAILIAN_* fallback fields intentionally).
READER_ARTICLE_RAG_EMBEDDING_PROVIDER=""
READER_ARTICLE_RAG_EMBEDDING_MODEL=""
# Vector store. Zilliz requires uri + token + collection + dim all non-empty.
# Values: "" | "zilliz". Dedicated READER_ARTICLE_RAG_ZILLIZ_* values win;
# when they are blank, local development falls back to the few-shot RAG
# ZILLIZ_URI / ZILLIZ_TOKEN above. Collection remains Article RAG-specific.
READER_ARTICLE_RAG_VECTOR_PROVIDER=""
READER_ARTICLE_RAG_ZILLIZ_URI=""
READER_ARTICLE_RAG_ZILLIZ_TOKEN=""
READER_ARTICLE_RAG_ZILLIZ_COLLECTION="article_rag_chunks"
READER_ARTICLE_RAG_VECTOR_DIM=1024
# Worker loop tuning (defaults are fine; only adjust for stale-lease or
# poll-rate diagnostics).
READER_ARTICLE_RAG_WORKER_POLL_INTERVAL_SECONDS=5
READER_ARTICLE_RAG_WORKER_LEASE_DURATION_SECONDS=120
READER_ARTICLE_RAG_WORKER_LEASE_OWNER_PREFIX="reader-article-rag-index-worker"
READER_ARTICLE_RAG_WORKER_MAX_TICKS=100
# Opt-in gate for the real-provider integration smoke. CI defaults to skip;
# local runs of `READER_ARTICLE_RAG_SMOKE=1 pytest -m article_rag_smoke`.
# DO NOT set this in production deployments.
READER_ARTICLE_RAG_SMOKE=false

INTERNAL_API_KEY=""
